# Neon pooled URL using a non-owner runtime login role.
NUXT_DATABASE_URL=
# Neon direct URL using the migration owner role.
NUXT_DATABASE_DIRECT_URL=
# Dedicated test branch/database only. test:neon inserts and deletes fixtures.
NUXT_DATABASE_TEST_URL=
NUXT_DATABASE_TEST_DIRECT_URL=
NUXT_BETTER_AUTH_SECRET=
NUXT_BETTER_AUTH_URL=http://localhost:3000
NUXT_GOOGLE_API_KEY=
# Random secret of at least 32 characters for 10-minute original-download tickets.
NUXT_DOWNLOAD_TICKET_SECRET=
# Folder công khai tối đa 3.000 ảnh; test:drive-live báo riêng mức độ kiểm chứng album lớn/resource key.
NUXT_DRIVE_SAMPLE_FOLDER_URL=
# Keep false until the public/shared folder API spike passes.
NUXT_DRIVE_VERIFIED=false
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
NUXT_SMTP_URL=
NUXT_MAIL_FROM=
# GA4 stays disabled locally and on Preview; enable only in Vercel Production.
NUXT_PUBLIC_GA4_ENABLED=
NUXT_PUBLIC_GA4_MEASUREMENT_ID=
